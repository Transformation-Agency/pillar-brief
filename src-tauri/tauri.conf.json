{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pillar Brief",
  "version": "0.1.6",
  "identifier": "com.pillarbrief.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": "true",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pillar-brief-backend", "binaries/whisper-cli", "binaries/pillar-audio-convert"],
    "resources": ["resources/backend", "resources/whisper", "icons/tray-template.png", "icons/tray-template@1x.png"],
    "shortDescription": "Local daily intelligence brief console.",
    "longDescription": "Pillar Brief packages a local intelligence brief console for macOS while sharing the same web backend used for self-hosting.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 760,
          "height": 420
        },
        "appPosition": {
          "x": 210,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 550,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDOTJDMUQxNDg1RDFDQ0EKUldUS0hGMUkwY0dTYklBdHNnRCtGM1phK1NnQTUyVC9PUWRBRnZMQWpEdk1OS3BBeThSYmk0SUUK",
      "endpoints": [
        "https://github.com/Transformation-Agency/pillar-brief/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
