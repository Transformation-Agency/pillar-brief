{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local-pillar-brief",
  "description": "Allows the main Pillar Brief desktop webview to check, install, and restart into signed app updates.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": ["core:default", "updater:default", "process:allow-restart"]
}
