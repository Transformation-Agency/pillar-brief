# Pillar Brief environment example
#
# Credentials can also be added inside Settings. Environment variables are useful
# for self-hosted deployments, containers, or desktop development.

# Server
HOST=127.0.0.1
PORT=5173
PILLAR_APP_MODE=web
PILLAR_DATA_DIR=./data
# PILLAR_DB_PATH=./data/pillar-brief.sqlite

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Custom OpenAI-compatible provider
CUSTOM_MODEL_API_KEY=
# CUSTOM_MODEL_BASE_URL=http://localhost:11434/v1

# Optional podcast transcription override
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Optional local speech-to-text with whisper.cpp
# WHISPER_CPP_PATH=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-tiny.en.bin
# WHISPER_MODEL_NAME=tiny.en
